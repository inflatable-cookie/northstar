{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://northstar.invalid/schemas/lifecycle-projection.v1.json",
  "title": "Northstar deterministic Markdown projection v1",
  "description": "Metadata for one generated Markdown block. The block renders this document as a fixed-grammar table between stable sentinels. The source digest binds the block to the exact record set it rendered.",
  "type": "object",
  "required": ["schema_version", "source_digest", "entries"],
  "properties": {
    "schema_version": { "const": "northstar.lifecycle.projection.v1" },
    "source_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["task_id", "status", "stage", "revision", "record_digest"],
        "properties": {
          "task_id": {
            "type": "string",
            "pattern": "^g[0-9]{2}\\.[0-9]{3}$"
          },
          "status": {
            "enum": ["planned", "ready", "active", "blocked", "complete", "cancelled", "superseded"]
          },
          "stage": {
            "enum": ["none", "dispatch", "implementation", "review", "merge", "closeout"]
          },
          "revision": { "type": "integer", "minimum": 1 },
          "record_digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
