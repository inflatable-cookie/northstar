{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://northstar.invalid/schemas/queue-control.v1.json",
  "title": "Queue generic control manifest v1 (paseo.queue.control.v1)",
  "description": "Northstar's committed record of the frozen Queue control-manifest contract at installed revision 2c528543b00147556acd4a5ed74b3784d0fee056. The grammar is document-system agnostic: no Northstar paths, commands, IDs, or Markdown rules appear. Binding cross-rules (unique ids and events, read_only restrictions, integration_write commit subject) are enforced by adapter code; the 64 KiB byte cap is a file-size check.",
  "type": "object",
  "required": ["schema", "hooks"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "paseo.queue.control.v1" },
    "hooks": {
      "type": "array",
      "minItems": 0,
      "maxItems": 16,
      "items": { "$ref": "#/$defs/hook" }
    }
  },
  "$defs": {
    "eventName": { "enum": ["task.pre_dispatch", "task.blocked", "task.cancelled", "task.closeout"] },
    "repoPath": { "type": "string", "minLength": 1, "maxLength": 1024 },
    "allowedPath": { "type": "string", "minLength": 1, "maxLength": 1024 },
    "argvValue": { "type": "string", "maxLength": 1024 },
    "commitSubject": {
      "type": "object",
      "required": ["prefix", "maxBytes"],
      "additionalProperties": false,
      "properties": {
        "prefix": { "type": "string", "minLength": 1, "maxLength": 50 },
        "maxBytes": { "type": "integer", "minimum": 20, "maximum": 100 }
      }
    },
    "hook": {
      "type": "object",
      "required": ["id", "events", "mode", "delivery", "executable", "timeoutMs", "maxOutputBytes"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$" },
        "events": { "type": "array", "minItems": 1, "maxItems": 4, "items": { "$ref": "#/$defs/eventName" }, "uniqueItems": true },
        "mode": { "enum": ["read_only", "integration_write"] },
        "delivery": { "enum": ["required", "advisory"] },
        "executable": { "$ref": "#/$defs/repoPath" },
        "argv": { "type": "array", "maxItems": 32, "items": { "$ref": "#/$defs/argvValue" } },
        "timeoutMs": { "type": "integer", "minimum": 100, "maximum": 120000 },
        "maxOutputBytes": { "type": "integer", "minimum": 1024, "maximum": 1048576 },
        "allowedPaths": { "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/allowedPath" } },
        "commitSubject": { "oneOf": [{ "$ref": "#/$defs/commitSubject" }, { "type": "null" }] }
      }
    }
  }
}
