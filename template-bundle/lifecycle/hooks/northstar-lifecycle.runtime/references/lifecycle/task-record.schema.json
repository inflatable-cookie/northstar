{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://northstar.invalid/schemas/lifecycle-task-record.v1.json",
  "title": "Northstar portable task lifecycle record v1",
  "description": "Canonical per-task mechanical lifecycle record. JSON is canonical; Markdown projections are derived. Human-owned semantic text lives in the task Markdown, never here.",
  "type": "object",
  "required": [
    "schema_version",
    "task_id",
    "task_path",
    "generation",
    "planning",
    "revision",
    "status",
    "stage",
    "dependencies",
    "delivery_policy",
    "evidence",
    "applied_events",
    "adapter",
    "updated_at",
    "portable_digest",
    "digest"
  ],
  "properties": {
    "schema_version": { "const": "northstar.lifecycle.task-record.v1" },
    "task_id": {
      "type": "string",
      "pattern": "^g[0-9]{2}\\.[0-9]{3}$"
    },
    "task_path": {
      "type": "string",
      "pattern": "^docs/roadmaps/g[0-9]{2}/[0-9]{3}-[a-z0-9]+(-[a-z0-9]+)*\\.md$"
    },
    "generation": {
      "type": "string",
      "pattern": "^g[0-9]{2}$"
    },
    "planning": {
      "type": "object",
      "required": ["commit", "task_blob_digest"],
      "properties": {
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$|^[0-9a-f]{64}$"
        },
        "task_blob_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    },
    "revision": { "type": "integer", "minimum": 1 },
    "status": {
      "enum": ["planned", "ready", "active", "blocked", "complete", "cancelled", "superseded"]
    },
    "stage": {
      "enum": ["none", "dispatch", "implementation", "review", "merge", "closeout"]
    },
    "block": {
      "type": "object",
      "required": [
        "reason_code",
        "reason",
        "prior_status",
        "prior_stage",
        "resume_status",
        "resume_stage",
        "blocked_at"
      ],
      "properties": {
        "reason_code": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 },
        "prior_status": {
          "enum": ["planned", "ready", "active", "blocked"]
        },
        "prior_stage": {
          "enum": ["none", "dispatch", "implementation", "review", "merge", "closeout"]
        },
        "resume_status": {
          "enum": ["planned", "ready", "active"]
        },
        "resume_stage": {
          "enum": ["none", "dispatch", "implementation", "review", "merge", "closeout"]
        },
        "blocked_at": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{3})?Z$"
        }
      },
      "additionalProperties": false
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^g[0-9]{2}\\.[0-9]{3}$"
      },
      "uniqueItems": true
    },
    "delivery_policy": {
      "type": "object",
      "required": ["mode"],
      "properties": {
        "mode": { "enum": ["standard", "direct_delivery", "review_skip"] },
        "authorization_ref": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "properties": {
        "implementation": { "$ref": "evidence.schema.json#/$defs/evidenceEntry" },
        "pr": { "$ref": "evidence.schema.json#/$defs/evidenceEntry" },
        "review": { "$ref": "evidence.schema.json#/$defs/evidenceEntry" },
        "verification": { "$ref": "evidence.schema.json#/$defs/evidenceEntry" },
        "merge": { "$ref": "evidence.schema.json#/$defs/evidenceEntry" },
        "integration": { "$ref": "evidence.schema.json#/$defs/evidenceEntry" },
        "validation": { "$ref": "evidence.schema.json#/$defs/evidenceEntry" },
        "handoff": { "$ref": "evidence.schema.json#/$defs/evidenceEntry" },
        "limitation": { "$ref": "evidence.schema.json#/$defs/evidenceEntry" },
        "continuation": { "$ref": "evidence.schema.json#/$defs/evidenceEntry" },
        "authorization": { "$ref": "evidence.schema.json#/$defs/evidenceEntry" }
      },
      "additionalProperties": false
    },
    "applied_events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["event_id", "content_digest", "transition", "revision"],
        "properties": {
          "event_id": { "type": "string", "minLength": 8, "maxLength": 128 },
          "content_digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "transition": {
            "enum": ["plan", "ready", "start", "advance_stage", "block", "resume", "complete", "cancel", "supersede"]
          },
          "revision": { "type": "integer", "minimum": 1 }
        },
        "additionalProperties": false
      }
    },
    "adapter": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "instance": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "updated_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{3})?Z$"
    },
    "portable_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  },
  "additionalProperties": false
}
