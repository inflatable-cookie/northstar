{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://northstar.invalid/schemas/queue-result.v1.json",
  "title": "Queue generic hook result v1 (paseo.queue.hook-result.v1)",
  "description": "Northstar's committed record of the frozen Queue hook-result contract at installed revision 2c528543b00147556acd4a5ed74b3784d0fee056. The hook adapter self-checks exactly one such object on stdout. Byte-length caps beyond maxLength are enforced in adapter code.",
  "type": "object",
  "required": ["schema", "eventId", "outcome", "summary", "metadata", "changedPaths", "commitSubjectSuffix"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "paseo.queue.hook-result.v1" },
    "eventId": { "type": "string", "minLength": 1, "maxLength": 240 },
    "outcome": { "enum": ["ok", "blocked", "failed"] },
    "summary": { "type": "string", "minLength": 1, "maxLength": 4000 },
    "metadata": { "type": "object" },
    "changedPaths": {
      "type": "array",
      "maxItems": 4096,
      "items": { "type": "string", "minLength": 1, "maxLength": 1024 }
    },
    "commitSubjectSuffix": { "oneOf": [{ "type": "string", "maxLength": 100 }, { "type": "null" }] }
  }
}
