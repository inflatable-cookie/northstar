# Apply this template when the Northstar docs spine lives inside a nested
# authority repo such as `ledger/`, `trellis/`, `cp-docs/`, `acme-docs/`, or
# `composer-docs/`, and the workspace root delegates into it.

[catalog]
alias = "{{DOCS_AUTHORITY_ALIAS}}"

[docs_policy.indexes.vision]
file = "{{DOCS_AUTHORITY_PATH}}/vision/README.md"
dir = "{{DOCS_AUTHORITY_PATH}}/vision"
section = "Vision Artifacts"
exclude = ["history/**"]

[tasks]
"qa:docs:links" = "effigy docs check-links {{DOCS_AUTHORITY_PATH}}/README.md {{DOCS_AUTHORITY_PATH}}/roadmaps/README.md {{DOCS_AUTHORITY_PATH}}/logs/README.md {{DOCS_AUTHORITY_PATH}}/vision/README.md"
"qa:docs:agent-defaults" = "effigy docs check-forbidden AGENTS.md README.md --forbid '--repo .'"
"qa:docs:headings" = "effigy docs check-headings {{DOCS_AUTHORITY_PATH}}/roadmaps/README.md --require-heading '## Next Task'"
"qa:northstar:vision" = "effigy docs check-headings {{DOCS_AUTHORITY_PATH}}/vision/README.md --require-heading '## Current Entrypoint' --require-heading '## Working Rule'"
"qa:northstar:roadmaps" = "effigy docs check-headings {{DOCS_AUTHORITY_PATH}}/roadmaps/README.md --require-heading '## Generation Model' --require-heading '## Layout' --require-heading '## Current Queue' --require-heading '## Next Task'"
"qa:northstar:generation-runway" = "effigy docs check-headings {{DOCS_AUTHORITY_PATH}}/roadmaps/g01/README.md --require-heading '## Generation Runway' --require-heading '## Next Task'"
"qa:northstar" = [
  { task = "qa:docs:headings" },
  { task = "qa:northstar:vision" },
  { task = "qa:northstar:roadmaps" },
  { task = "qa:northstar:generation-runway" },
]
"qa:docs" = [
  { task = "qa:docs:links" },
  { task = "qa:docs:agent-defaults" },
  { task = "qa:northstar" },
]

# Cheap orientation for `effigy doctor`. Full board is `effigy qa`.
# Never alias health to qa.
health = [{ task = "qa:docs:agent-defaults" }]
qa = [{ task = "qa:docs" }]
