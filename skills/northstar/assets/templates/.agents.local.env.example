# Local-only agent paths. Copy this file to `.agents.local.env` when needed.
# `.agents.local.env` is ignored and must never contain credentials or secrets.
# Paths must be absolute. Leave optional values empty when they are not needed.

# Required only when an agent must create a Git worktree manually.
# The agent asks for this path before creating the first manual worktree.
AGENTS_WORKTREE_CONTAINER_DIR=

# Optional shared location for agent scratch files and temporary reports.
AGENTS_SCRATCH_DIR=

# Optional location for large local artifacts that should not live in the repo.
AGENTS_ARTIFACT_DIR=
