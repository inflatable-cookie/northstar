{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://northstar.invalid/schemas/language-package-manifest.v1.json",
  "title": "Northstar language quality package manifest",
  "type": "object",
  "required": [
    "schema_version",
    "package_id",
    "version",
    "kind",
    "compatible_core_range",
    "supported_languages",
    "supported_overlays",
    "available_workflows",
    "entrypoints",
    "runtime_capabilities",
    "self_check"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "package_id": {
      "type": "string",
      "pattern": "^@[a-z0-9-]+/[a-z0-9-]+$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "kind": {
      "type": "string",
      "const": "language-quality"
    },
    "compatible_core_range": {
      "type": "string",
      "pattern": "^(\\*|[0-9]+\\.[0-9]+\\.[0-9]+|\\^[0-9]+\\.[0-9]+\\.[0-9]+|>=[0-9]+\\.[0-9]+\\.[0-9]+ <[0-9]+\\.[0-9]+\\.[0-9]+|>=[0-9]+\\.[0-9]+\\.[0-9]+|<[0-9]+\\.[0-9]+\\.[0-9]+)$"
    },
    "supported_languages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "supported_overlays": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "available_workflows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": [
          "everyday_authoring",
          "explicit_audit_repair"
        ]
      }
    },
    "entrypoints": {
      "type": "object",
      "required": [],
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-zA-Z0-9_-][a-zA-Z0-9_.-]*(/[a-zA-Z0-9_-][a-zA-Z0-9_.-]*)*$"
      }
    },
    "runtime_capabilities": {
      "type": "object",
      "required": [
        "required_commands",
        "optional_effigy_selectors"
      ],
      "properties": {
        "required_commands": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "optional_effigy_selectors": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    },
    "self_check": {
      "type": "object",
      "required": [
        "entrypoint",
        "validated_profile_versions",
        "validated_schema_versions"
      ],
      "properties": {
        "entrypoint": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-][a-zA-Z0-9_.-]*(/[a-zA-Z0-9_-][a-zA-Z0-9_.-]*)*$"
        },
        "validated_profile_versions": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
          }
        },
        "validated_schema_versions": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
          }
        }
      },
      "additionalProperties": false
    },
    "evidence_providers": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "additionalProperties": false
}
