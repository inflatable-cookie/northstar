{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://northstar.invalid/schemas/language-package-operator-trust.v1.json",
  "title": "Northstar language package operator trust",
  "type": "object",
  "required": [
    "schema_version",
    "revision",
    "allowlist",
    "revocations"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "revision": {
      "type": "string",
      "pattern": "^[0-9]+$"
    },
    "allowlist": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "package_id",
          "version",
          "source_identity",
          "tree_digest",
          "manifest_digest",
          "compatible_core_range",
          "actor",
          "timestamp",
          "reason"
        ],
        "properties": {
          "package_id": {
            "type": "string",
            "pattern": "^@[a-z0-9-]+/[a-z0-9-]+$"
          },
          "version": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
          },
          "source_identity": {
            "oneOf": [
              {
                "type": "object",
                "required": [
                  "type",
                  "repository",
                  "subpath",
                  "commit"
                ],
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "git"
                  },
                  "repository": {
                    "type": "string",
                    "pattern": "^https://[a-zA-Z0-9.-]+(/[^/]+)*$"
                  },
                  "subpath": {
                    "type": "string",
                    "pattern": "^[a-zA-Z0-9_-][a-zA-Z0-9_.-]*(/[a-zA-Z0-9_-][a-zA-Z0-9_.-]*)*$"
                  },
                  "commit": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{40}$|^[0-9a-f]{64}$"
                  }
                },
                "additionalProperties": false
              },
              {
                "type": "object",
                "required": [
                  "type",
                  "path"
                ],
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "local_path"
                  },
                  "path": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "additionalProperties": false
              },
              {
                "type": "object",
                "required": [
                  "type",
                  "url",
                  "archive_digest"
                ],
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "archive"
                  },
                  "url": {
                    "type": "string",
                    "pattern": "^https://[a-zA-Z0-9.-]+(/[^/]+)*$"
                  },
                  "archive_digest": {
                    "type": "string",
                    "pattern": "^(sha256:)?[0-9a-f]{64}$"
                  },
                  "subpath": {
                    "type": "string",
                    "pattern": "^[a-zA-Z0-9_-][a-zA-Z0-9_.-]*(/[a-zA-Z0-9_-][a-zA-Z0-9_.-]*)*$"
                  }
                },
                "additionalProperties": false
              }
            ]
          },
          "tree_digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "manifest_digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "compatible_core_range": {
            "type": "string",
            "pattern": "^(\\*|[0-9]+\\.[0-9]+\\.[0-9]+|\\^[0-9]+\\.[0-9]+\\.[0-9]+|>=[0-9]+\\.[0-9]+\\.[0-9]+ <[0-9]+\\.[0-9]+\\.[0-9]+|>=[0-9]+\\.[0-9]+\\.[0-9]+|<[0-9]+\\.[0-9]+\\.[0-9]+)$"
          },
          "workflows": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "everyday_authoring",
                "explicit_audit_repair"
              ]
            }
          },
          "consumer_scope": {
            "type": "string",
            "minLength": 1
          },
          "actor": {
            "type": "string",
            "minLength": 1
          },
          "timestamp": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z?$"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "revocations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "package_id",
          "version",
          "tree_digest",
          "manifest_digest",
          "actor",
          "timestamp",
          "reason"
        ],
        "properties": {
          "package_id": {
            "type": "string",
            "pattern": "^@[a-z0-9-]+/[a-z0-9-]+$"
          },
          "version": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
          },
          "tree_digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "manifest_digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "actor": {
            "type": "string",
            "minLength": 1
          },
          "timestamp": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z?$"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
