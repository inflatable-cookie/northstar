{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://northstar.invalid/schemas/language-package-overlap-windows.v1.json",
  "title": "Northstar language package overlap windows",
  "type": "object",
  "description": "Schema-validated overlap-window registry. Each entry binds one language to an exact package ID and version plus the human-facing frozen-payload label.",
  "required": [
    "schema_version",
    "windows"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "windows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "language",
          "package_id",
          "version",
          "payload_label",
          "window"
        ],
        "properties": {
          "language": {
            "type": "string",
            "minLength": 1
          },
          "package_id": {
            "type": "string",
            "pattern": "^@[a-z0-9-]+/[a-z0-9-]+$"
          },
          "version": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
          },
          "payload_label": {
            "type": "string",
            "minLength": 1
          },
          "window": {
            "type": "string",
            "enum": [
              "open",
              "closed"
            ]
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
