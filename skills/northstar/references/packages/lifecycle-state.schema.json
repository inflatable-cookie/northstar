{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://northstar.invalid/schemas/language-package-lifecycle-state.v1.json",
  "title": "Northstar language package lifecycle state",
  "type": "object",
  "required": [
    "schema_version",
    "state_revision",
    "packages"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "state_revision": {
      "type": "string",
      "pattern": "^[0-9]+$"
    },
    "packages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "package_id",
          "version",
          "tree_digest",
          "manifest_digest",
          "receipt_digest",
          "installed_path",
          "selection",
          "installed_at"
        ],
        "properties": {
          "package_id": {
            "type": "string",
            "pattern": "^@[a-z0-9-]+/[a-z0-9-]+$"
          },
          "version": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
          },
          "tree_digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "manifest_digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "receipt_digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "installed_path": {
            "type": "string",
            "minLength": 1
          },
          "selection": {
            "type": "string",
            "enum": [
              "selected",
              "retained"
            ]
          },
          "installed_at": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z?$"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
