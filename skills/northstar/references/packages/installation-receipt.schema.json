{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://northstar.invalid/schemas/language-package-installation-receipt.v1.json",
  "title": "Northstar language package installation receipt",
  "type": "object",
  "required": [
    "schema_version",
    "package_id",
    "version",
    "kind",
    "trust_class",
    "source",
    "content_identity",
    "compatibility",
    "installation"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "package_id": {
      "type": "string",
      "pattern": "^@[a-z0-9-]+/[a-z0-9-]+$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "kind": {
      "type": "string",
      "const": "language-quality"
    },
    "trust_class": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "type",
            "registry_version",
            "registry_entry_digest"
          ],
          "properties": {
            "type": {
              "type": "string",
              "const": "official"
            },
            "registry_version": {
              "type": "string",
              "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
            },
            "registry_entry_digest": {
              "type": "string",
              "pattern": "^(sha256:)?[0-9a-f]{64}$"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "type",
            "allowlist_entry",
            "allowlisted_by"
          ],
          "properties": {
            "type": {
              "type": "string",
              "const": "operator_allowlist"
            },
            "allowlist_entry": {
              "type": "string",
              "minLength": 1
            },
            "allowlisted_by": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "type",
            "approved_by",
            "approval_timestamp",
            "approval_scope"
          ],
          "properties": {
            "type": {
              "type": "string",
              "const": "interactive_approval"
            },
            "approved_by": {
              "type": "string",
              "minLength": 1
            },
            "approval_timestamp": {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z?$"
            },
            "approval_scope": {
              "type": "string",
              "enum": [
                "session",
                "workspace",
                "permanent"
              ]
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "source": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "type",
            "repository",
            "subpath",
            "commit"
          ],
          "properties": {
            "type": {
              "type": "string",
              "const": "git"
            },
            "repository": {
              "type": "string",
              "pattern": "^https://[a-zA-Z0-9.-]+(/[^/]+)*$"
            },
            "subpath": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9_-][a-zA-Z0-9_.-]*(/[a-zA-Z0-9_-][a-zA-Z0-9_.-]*)*$"
            },
            "commit": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$|^[0-9a-f]{64}$"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "type",
            "path",
            "acquisition_mode"
          ],
          "properties": {
            "type": {
              "type": "string",
              "const": "local_path"
            },
            "path": {
              "type": "string",
              "minLength": 1
            },
            "acquisition_mode": {
              "type": "string",
              "enum": [
                "manual",
                "local"
              ]
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "type",
            "url",
            "archive_digest"
          ],
          "properties": {
            "type": {
              "type": "string",
              "const": "archive"
            },
            "url": {
              "type": "string",
              "pattern": "^https://[a-zA-Z0-9.-]+(/[^/]+)*$"
            },
            "archive_digest": {
              "type": "string",
              "pattern": "^(sha256:)?[0-9a-f]{64}$"
            },
            "subpath": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9_-][a-zA-Z0-9_.-]*(/[a-zA-Z0-9_-][a-zA-Z0-9_.-]*)*$"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "content_identity": {
      "type": "object",
      "required": [
        "package_tree_digest",
        "manifest_digest"
      ],
      "properties": {
        "package_tree_digest": {
          "type": "string",
          "pattern": "^(sha256:)?[0-9a-f]{64}$"
        },
        "manifest_digest": {
          "type": "string",
          "pattern": "^(sha256:)?[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    },
    "compatibility": {
      "type": "object",
      "required": [
        "compatible_core_range",
        "installed_core_version"
      ],
      "properties": {
        "compatible_core_range": {
          "type": "string",
          "pattern": "^(\\*|[0-9]+\\.[0-9]+\\.[0-9]+|\\^[0-9]+\\.[0-9]+\\.[0-9]+|>=[0-9]+\\.[0-9]+\\.[0-9]+ <[0-9]+\\.[0-9]+\\.[0-9]+|>=[0-9]+\\.[0-9]+\\.[0-9]+|<[0-9]+\\.[0-9]+\\.[0-9]+)$"
        },
        "installed_core_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        }
      },
      "additionalProperties": false
    },
    "installation": {
      "type": "object",
      "required": [
        "installed_path",
        "installed_at",
        "acquisition_adapter",
        "activation_status"
      ],
      "properties": {
        "installed_path": {
          "type": "string",
          "minLength": 1
        },
        "installed_at": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z?$"
        },
        "acquisition_adapter": {
          "type": "string",
          "minLength": 1
        },
        "activation_status": {
          "type": "string",
          "enum": [
            "active",
            "inactive",
            "installed"
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
