{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://northstar.invalid/schemas/rust-quality-audit-unit.v2.json",
  "title": "Northstar Rust quality v2 unit assessment",
  "type": "object",
  "required": ["schema_version", "unit_id", "verdicts", "attestations", "findings", "repair_plans", "limitations"],
  "properties": {
    "schema_version": { "const": "northstar.rust-quality.assessment.v1" },
    "unit_id": { "$ref": "#/$defs/id" },
    "verdicts": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/verdict" } },
    "attestations": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "$ref": "#/$defs/attestation" } },
    "findings": { "type": "array", "items": { "$ref": "#/$defs/finding" } },
    "repair_plans": { "type": "array", "items": { "$ref": "#/$defs/plan" } },
    "limitations": { "type": "array", "items": { "$ref": "#/$defs/limitation" } }
  },
  "additionalProperties": false,
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$" },
    "rule": { "type": "string", "pattern": "^RUST-[A-Z]+-[0-9]{3}$" },
    "path": { "type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$" },
    "texts": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "verdict": {
      "type": "object",
      "required": ["rule_id", "verdict", "inspected_surfaces", "evidence", "finding_ids", "limitation_keys", "applicability_evidence"],
      "properties": {
        "rule_id": { "$ref": "#/$defs/rule" },
        "verdict": { "enum": ["pass", "finding", "not_applicable", "degraded"] },
        "inspected_surfaces": { "$ref": "#/$defs/texts" },
        "evidence": { "$ref": "#/$defs/texts" },
        "finding_ids": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
        "limitation_keys": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "applicability_evidence": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      },
      "additionalProperties": false
    },
    "attestation": {
      "type": "object",
      "required": ["dimension", "inspected_surfaces", "evidence"],
      "properties": {
        "dimension": { "enum": ["correctness_assurance", "architecture", "human_quality"] },
        "inspected_surfaces": { "$ref": "#/$defs/texts" },
        "evidence": { "$ref": "#/$defs/texts" }
      },
      "additionalProperties": false
    },
    "finding": {
      "type": "object",
      "required": ["finding_id", "rule_id", "action", "file", "evidence", "disposition"],
      "properties": {
        "finding_id": { "$ref": "#/$defs/id" },
        "rule_id": { "$ref": "#/$defs/rule" },
        "action": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "file": { "$ref": "#/$defs/path" },
        "evidence": { "type": "string", "minLength": 1 },
        "disposition": { "enum": ["repair_planned", "reported", "deviation", "operator_decision"] }
      },
      "additionalProperties": false
    },
    "plan": {
      "type": "object",
      "required": ["plan_id", "finding_ids", "owned_files", "preserved_behavior"],
      "properties": {
        "plan_id": { "$ref": "#/$defs/id" },
        "finding_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
        "owned_files": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/path" } },
        "preserved_behavior": { "$ref": "#/$defs/texts" }
      },
      "additionalProperties": false
    },
    "limitation": {
      "type": "object",
      "required": ["key", "kind", "evidence"],
      "properties": {
        "key": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "minLength": 1 },
        "evidence": { "$ref": "#/$defs/texts" }
      },
      "additionalProperties": false
    }
  }
}
