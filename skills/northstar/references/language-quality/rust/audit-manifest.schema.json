{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://northstar.invalid/schemas/rust-quality-audit-manifest.v2.json",
  "title": "Northstar Rust quality v2 audit manifest",
  "type": "object",
  "required": ["schema_version", "audit_id", "repository_root", "scope", "discovery_sha256", "plan_sha256", "policy_sha256", "profile_sha256", "deviations_sha256", "units", "excluded_files", "baseline_sha256"],
  "properties": {
    "schema_version": { "const": "northstar.rust-quality.audit-manifest.v2" },
    "audit_id": { "$ref": "#/$defs/id" },
    "repository_root": { "type": "string", "minLength": 1 },
    "scope": { "enum": ["worktree", "repository"] },
    "discovery_sha256": { "$ref": "#/$defs/sha256" },
    "plan_sha256": { "$ref": "#/$defs/sha256" },
    "policy_sha256": { "$ref": "#/$defs/sha256" },
    "profile_sha256": { "$ref": "#/$defs/sha256" },
    "deviations_sha256": { "$ref": "#/$defs/sha256" },
    "units": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/unit" } },
    "excluded_files": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/path" } },
    "baseline_sha256": { "type": "object", "minProperties": 1, "additionalProperties": { "$ref": "#/$defs/fingerprint" } }
  },
  "additionalProperties": false,
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "fingerprint": { "type": "string", "pattern": "^(?:[a-f0-9]{64}|missing)$" },
    "path": { "type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$" },
    "unit": {
      "type": "object",
      "required": ["unit_id", "anchors", "mutable_files", "read_only_files", "extensions"],
      "properties": {
        "unit_id": { "$ref": "#/$defs/id" },
        "anchors": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/path" } },
        "mutable_files": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/path" } },
        "read_only_files": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/path" } },
        "extensions": { "type": "array", "items": { "type": "object" } }
      },
      "additionalProperties": false
    }
  }
}
