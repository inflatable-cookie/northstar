{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://northstar.invalid/schemas/rust-quality-audit-result.v2.json",
  "title": "Northstar Rust quality v2 audit result",
  "type": "object",
  "required": ["schema_version", "audit_id", "scope", "status", "discovery_sha256", "plan_sha256", "policy_sha256", "profile_sha256", "deviations_sha256", "changed_files", "limitations", "units"],
  "properties": {
    "schema_version": { "const": "northstar.rust-quality.audit-result.v2" },
    "audit_id": { "type": "string", "minLength": 1 },
    "scope": { "enum": ["worktree", "repository"] },
    "status": { "enum": ["clean", "degraded", "operator_action_required"] },
    "discovery_sha256": { "$ref": "#/$defs/sha256" },
    "plan_sha256": { "$ref": "#/$defs/sha256" },
    "policy_sha256": { "$ref": "#/$defs/sha256" },
    "profile_sha256": { "$ref": "#/$defs/sha256" },
    "deviations_sha256": { "$ref": "#/$defs/sha256" },
    "changed_files": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/path" } },
    "limitations": { "type": "array", "items": { "$ref": "#/$defs/limitation" } },
    "units": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["unit_id", "changed_files", "assessment", "completion", "evidence"] } }
  },
  "additionalProperties": false,
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "path": { "type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$" },
    "limitation": {
      "type": "object",
      "required": ["key", "kind", "evidence"],
      "properties": {
        "key": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "minLength": 1 },
        "evidence": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      },
      "additionalProperties": false
    }
  }
}
