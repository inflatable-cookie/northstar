{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://northstar.invalid/schemas/lifecycle-projection.v2.json",
  "title": "Northstar deterministic Markdown projection v2",
  "description": "Metadata for one generated Markdown block. The block names each declared active generation and its machine-derived runway state above the canonical task table. A singular declaration renders exactly one generation row; a parallel declaration renders one row per active generation in lexical order with the entry set grouped by generation and task id. The source digest binds the generation state and the entry set together, so a runway change is never rendered under a stale digest.",
  "type": "object",
  "required": ["schema_version", "source_digest", "entries"],
  "properties": {
    "schema_version": { "const": "northstar.lifecycle.projection.v2" },
    "generation": {
      "description": "Singular-form generation row. Present only in the sequential shape; the parallel shape carries `generations` instead.",
      "type": "string",
      "pattern": "^g[0-9]{2}$"
    },
    "disposition": {
      "description": "Generation disposition is open or closed and changes only through an explicit closure record; complete is never a generation disposition.",
      "enum": ["open", "closed"]
    },
    "runway_state": {
      "description": "Derived runway state of one declared active generation. Precedence: active, ready, blocked, planned, then planning_required when no nonterminal record remains.",
      "enum": ["planning_required", "planned", "blocked", "ready", "active"]
    },
    "generations": {
      "description": "Parallel-form rows: exactly one per declared active generation, lexically ordered and duplicate-free. Present only in the parallel shape; the sequential shape must not carry it.",
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["generation", "disposition", "runway_state"],
        "properties": {
          "generation": { "type": "string", "pattern": "^g[0-9]{2}$" },
          "disposition": { "enum": ["open", "closed"] },
          "runway_state": { "enum": ["planning_required", "planned", "blocked", "ready", "active"] }
        },
        "additionalProperties": false
      }
    },
    "source_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["task_id", "status", "stage", "revision", "record_digest"],
        "properties": {
          "task_id": {
            "type": "string",
            "pattern": "^g[0-9]{2}\\.[0-9]{3}$"
          },
          "status": {
            "enum": ["planned", "ready", "active", "blocked", "complete", "cancelled", "superseded"]
          },
          "stage": {
            "enum": ["none", "dispatch", "implementation", "review", "merge", "closeout"]
          },
          "revision": { "type": "integer", "minimum": 1 },
          "record_digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "oneOf": [
    {
      "description": "Sequential shape: one declared generation row and no parallel rows.",
      "required": ["generation", "disposition", "runway_state"],
      "properties": {
        "schema_version": { "const": "northstar.lifecycle.projection.v2" },
        "generation": { "type": "string", "pattern": "^g[0-9]{2}$" },
        "disposition": { "enum": ["open", "closed"] },
        "runway_state": { "enum": ["planning_required", "planned", "blocked", "ready", "active"] },
        "source_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "entries": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["task_id", "status", "stage", "revision", "record_digest"],
            "properties": {
              "task_id": { "type": "string", "pattern": "^g[0-9]{2}\\.[0-9]{3}$" },
              "status": { "enum": ["planned", "ready", "active", "blocked", "complete", "cancelled", "superseded"] },
              "stage": { "enum": ["none", "dispatch", "implementation", "review", "merge", "closeout"] },
              "revision": { "type": "integer", "minimum": 1 },
              "record_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    {
      "description": "Parallel shape: an ordered row set for the declared active generations and no singular keys.",
      "required": ["generations"],
      "properties": {
        "schema_version": { "const": "northstar.lifecycle.projection.v2" },
        "generations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "required": ["generation", "disposition", "runway_state"],
            "properties": {
              "generation": { "type": "string", "pattern": "^g[0-9]{2}$" },
              "disposition": { "enum": ["open", "closed"] },
              "runway_state": { "enum": ["planning_required", "planned", "blocked", "ready", "active"] }
            },
            "additionalProperties": false
          }
        },
        "source_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "entries": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["task_id", "status", "stage", "revision", "record_digest"],
            "properties": {
              "task_id": { "type": "string", "pattern": "^g[0-9]{2}\\.[0-9]{3}$" },
              "status": { "enum": ["planned", "ready", "active", "blocked", "complete", "cancelled", "superseded"] },
              "stage": { "enum": ["none", "dispatch", "implementation", "review", "merge", "closeout"] },
              "revision": { "type": "integer", "minimum": 1 },
              "record_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  ]
}
