{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://northstar.invalid/schemas/lifecycle-transition-envelope.v1.json",
  "title": "Northstar portable lifecycle transition envelope v1",
  "description": "Provider-neutral transition request. Standalone callers and later generic Queue hooks submit the same envelope shape. Adapters cannot replace the canonical record; the core validates the envelope, checks the record, applies one legal transition, and returns the new revision and digest.",
  "type": "object",
  "required": [
    "schema_version",
    "event_id",
    "task_id",
    "task_path",
    "generation",
    "expected",
    "transition",
    "event_time",
    "actor",
    "source",
    "planning"
  ],
  "properties": {
    "schema_version": { "const": "northstar.lifecycle.transition.v1" },
    "event_id": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "task_id": {
      "type": "string",
      "pattern": "^g[0-9]{2}\\.[0-9]{3}$"
    },
    "task_path": {
      "type": "string",
      "pattern": "^docs/roadmaps/g[0-9]{2}/[0-9]{3}-[a-z0-9]+(-[a-z0-9]+)*\\.md$"
    },
    "generation": {
      "type": "string",
      "pattern": "^g[0-9]{2}$"
    },
    "expected": {
      "type": "object",
      "required": ["revision", "digest"],
      "properties": {
        "revision": { "type": "integer", "minimum": 0 },
        "digest": {
          "oneOf": [
            { "type": "null" },
            { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
          ]
        }
      },
      "additionalProperties": false
    },
    "transition": {
      "enum": ["plan", "ready", "start", "advance_stage", "block", "resume", "complete", "cancel", "supersede"]
    },
    "event_time": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{3})?Z$"
    },
    "actor": { "type": "string", "minLength": 1 },
    "source": {
      "type": "object",
      "required": ["adapter"],
      "properties": {
        "adapter": { "type": "string", "minLength": 1 },
        "instance": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "planning": {
      "type": "object",
      "required": ["commit", "task_blob_digest"],
      "properties": {
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$|^[0-9a-f]{64}$"
        },
        "task_blob_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^g[0-9]{2}\\.[0-9]{3}$"
      },
      "uniqueItems": true
    },
    "policy": {
      "type": "object",
      "required": ["mode"],
      "properties": {
        "mode": { "enum": ["standard", "direct_delivery", "review_skip"] },
        "authorization_ref": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "target_stage": {
      "enum": ["none", "dispatch", "implementation", "review", "merge", "closeout"]
    },
    "superseded_by": { "type": "string", "minLength": 1 },
    "reason_code": { "type": "string", "minLength": 1 },
    "reason": { "type": "string", "minLength": 1 },
    "evidence": {
      "type": "object",
      "properties": {
        "implementation": { "$ref": "evidence.schema.json#/$defs/evidenceEntry" },
        "pr": { "$ref": "evidence.schema.json#/$defs/evidenceEntry" },
        "review": { "$ref": "evidence.schema.json#/$defs/evidenceEntry" },
        "verification": { "$ref": "evidence.schema.json#/$defs/evidenceEntry" },
        "merge": { "$ref": "evidence.schema.json#/$defs/evidenceEntry" },
        "integration": { "$ref": "evidence.schema.json#/$defs/evidenceEntry" },
        "validation": { "$ref": "evidence.schema.json#/$defs/evidenceEntry" },
        "handoff": { "$ref": "evidence.schema.json#/$defs/evidenceEntry" },
        "limitation": { "$ref": "evidence.schema.json#/$defs/evidenceEntry" },
        "continuation": { "$ref": "evidence.schema.json#/$defs/evidenceEntry" },
        "authorization": { "$ref": "evidence.schema.json#/$defs/evidenceEntry" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
