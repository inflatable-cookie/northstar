{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://northstar.invalid/schemas/lifecycle-evidence.v1.json",
  "title": "Northstar portable lifecycle evidence entry v1",
  "description": "One compact evidence entry. Every entry names its source, actor, method, and verification level. The reducer preserves the declared level and never upgrades an attestation into independent or cryptographic proof.",
  "type": "object",
  "$defs": {
    "gitId": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$|^[0-9a-f]{64}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "taskId": {
      "type": "string",
      "pattern": "^g[0-9]{2}\\.[0-9]{3}$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{3})?Z$"
    },
    "evidenceEntry": {
      "type": "object",
      "required": ["level", "source", "actor", "method", "recorded_at"],
      "properties": {
        "level": {
          "enum": ["locally_verified", "adapter_attested", "operator_authorized"]
        },
        "source": { "type": "string", "minLength": 1 },
        "actor": { "type": "string", "minLength": 1 },
        "method": { "type": "string", "minLength": 1 },
        "recorded_at": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{3})?Z$"
        },
        "provider": { "type": "string", "minLength": 1 },
        "provider_ref": { "type": "string", "minLength": 1 },
        "pr_number": { "type": "integer", "minimum": 1 },
        "head_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$|^[0-9a-f]{64}$"
        },
        "base": { "type": "string", "minLength": 1 },
        "verdict": { "enum": ["approved", "changes_requested"] },
        "review_id": { "type": "string", "minLength": 1 },
        "merge_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$|^[0-9a-f]{64}$"
        },
        "merge_method": { "enum": ["merge", "squash", "rebase"] },
        "synchronized_main_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$|^[0-9a-f]{64}$"
        },
        "passed": { "type": "boolean" },
        "command": { "type": "string", "minLength": 1 },
        "ref": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 },
        "details": { "type": "object" }
      },
      "additionalProperties": false
    }
  }
}
