#!/usr/bin/env bash
# Committed Queue hook launcher for the Northstar lifecycle adapter.
#
# Queue executes this pinned repository file with literal argv and no shell.
# The launcher resolves the installed Northstar skill (never the Northstar
# source checkout) and hands execution to its lifecycle Queue-event adapter,
# which reads the generic event JSON on stdin. Event data never reaches this
# script's arguments or environment beyond Queue's own contract variables.
set -euo pipefail

for base in "$HOME/.agents/skills/northstar" "$HOME/.pi/agent/skills/northstar"; do
  if [ -f "$base/scripts/lifecycle-queue-hook.ts" ]; then
    exec bun run "$base/scripts/lifecycle-queue-hook.ts"
  fi
done

echo "northstar lifecycle hook: installed Northstar skill not found under HOME" >&2
exit 1
